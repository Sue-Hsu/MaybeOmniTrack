rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Emergency maintenance lockdown (2026-09-09).
    // No client-side Firestore access is permitted while MaybeFinance migrates
    // authentication and secret handling to Supabase.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
